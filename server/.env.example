# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/report_followup?retryWrites=true&w=majority

# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

PORT=5000
NODE_ENV=development

# Only needed if the client is served from a different origin (not needed with the Vite proxy)
CLIENT_ORIGIN=

# Timezone used to decide what "today" is (Report dates cannot be in the future)
APP_TIMEZONE=Asia/Kolkata

# First Super Admin, created/updated by `npm run seed`
SUPERADMIN_NAME=Super Admin
SUPERADMIN_MOBILE=
SUPERADMIN_PASSWORD=

# Excel file with Jamiat sheets -> Jamaat rows (used by `npm run seed`)
MASTER_XLSX_PATH=C:\Users\Dell\Downloads\master_check.xlsx
